-- Sistema de Configuração Local
local FolderName = "ToxV1_Data"
local ConfigFilePath = FolderName .. "/config.json"

function Tox.AutoSaveConfiguration()
    if Tox.Destroyed or not writefile then return end
    pcall(function()
        if makefolder and isfolder and not isfolder(FolderName) then makefolder(FolderName) end
        local data = { Settings = Tox.Settings, SavedIDs = Tox.SavedIDs }
        writefile(ConfigFilePath, Services.HttpService:JSONEncode(data))
    end)
end

function Tox.LoadConfiguration()
    if not isfile or not readfile or not isfile(ConfigFilePath) then return end
    pcall(function()
        local data = Services.HttpService:JSONDecode(readfile(ConfigFilePath))
        if data and data.Settings then
            for k, v in pairs(data.Settings) do
                if k == "GUIKeybind" then pcall(function() Tox.Settings.GUIKeybind = Enum.KeyCode[v] end)
                else Tox.Settings[k] = v end
            end
        end
        if data and data.SavedIDs then Tox.SavedIDs = data.SavedIDs end
    end)
end
Tox.LoadConfiguration()

